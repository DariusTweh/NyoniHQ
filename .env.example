# OpenAI Agents API: powers the managed Codex harness for all eight agents.
OPENAI_API_KEY=

# Meta Model API: gives every agent an optional Muse Spark collaborator pass.
MODEL_API_KEY=

# Required on Vercel before paid agent execution is allowed.
NYONI_ACCESS_TOKEN=

# Existing Nyoni AI Studio backend. Keep the service-role key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NYONI_STUDIO_PROJECT_ID=

# Optional model overrides.
NYONI_CODEX_MODEL=gpt-6-astra
NYONI_MUSE_MODEL=muse-spark-1.3
